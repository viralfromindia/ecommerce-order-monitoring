[0m02:26:06.639825 [debug] [Thread-1 (]: On model.dbt_ecommerce.order_status: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "ecommerce", "target_name": "dev", "node_id": "model.dbt_ecommerce.order_status"} */
create or replace   view ecommerce_db.analytics_marts.order_status
  
   as (
    WITH base AS (
  SELECT o.order_id, c.name AS customer_name, o.order_date, s.status,
         s.shipped_at, s.delivered_at,
         DATEDIFF('hour', s.shipped_at, s.delivered_at) AS delivery_hours
  FROM ecommerce_db.analytics_staging.stg_orders o
  JOIN ecommerce_db.analytics_staging.stg_shipments s ON o.order_id = s.order_id
  JOIN ecommerce_db.analytics_staging.stg_customers c ON o.customer_id = c.customer_id
)

SELECT *,
       CASE WHEN status = 'shipped' AND delivery_hours > 48 THEN 'DELAYED' ELSE status END AS final_status
FROM base
  );
